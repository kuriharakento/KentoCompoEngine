# Doxyfile for KentoCompoEngine (Submodule-level)

# プロジェクト情報
PROJECT_NAME           = "KentoCompoEngine"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Game Engine for TD4-2"
OUTPUT_DIRECTORY       = docs

# 言語と文字コード
OUTPUT_LANGUAGE        = Japanese
DOXYFILE_ENCODING      = UTF-8

# 入力設定 (Doxyfileと同じディレクトリであるengine配下を解析)
INPUT                  = .
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.cpp
RECURSIVE              = YES
EXCLUDE                = externals

# 出力フォーマットの設定
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO

# 抽出設定
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
SHOW_INCLUDE_FILES     = YES

# クラス図とグラフの生成 (Graphvizを使用)
CLASS_DIAGRAMS         = YES
HAVE_DOT               = YES
DOT_NUM_THREADS        = 4
UML_LOOK               = YES
TEMPLATE_RELATIONS     = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DIRECTORY_GRAPH        = YES

# Doxygenの表示設定
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
